# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git에 올라가지 않아요)

# 웹에서 게이지를 바꿀 때 쓰는 비밀번호 (신채호만 알면 됨)
ADMIN_PASSWORD=여기에-비밀번호

# 디스코드 개발자 포털 > 내 앱 > General Information
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# 디스코드 개발자 포털 > 내 앱 > Bot > Reset Token (명령 등록할 때만 필요)
DISCORD_BOT_TOKEN=
# 명령을 바로 쓰고 싶은 디스코드 서버 ID (선택)
DISCORD_GUILD_ID=
# 신채호의 디스코드 사용자 ID (이 사람만 /분노 로 값을 바꿀 수 있음)
DISCORD_OWNER_ID=
# 변경 알림을 보낼 채널의 웹훅 주소 (채널 설정 > 연동 > 웹후크)
DISCORD_WEBHOOK_URL=

# 배포된 사이트 주소 (알림에 링크로 붙음, 선택)
PUBLIC_URL=

# 게이지 값을 영구 저장하고 싶을 때 (Render 무료 플랜 권장, 선택)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 처음 시작할 때 게이지 값 (선택, 기본 0)
INITIAL_VALUE=0
